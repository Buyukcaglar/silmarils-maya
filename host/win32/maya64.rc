// maya64.rc - the Windows host's resources: the icon (1), the manifest and the version.
#pragma code_page(65001)
#include <winver.h>
#include <winuser.h>
#include "host_config.h"

1 ICON "../../res/maya64.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "maya64.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HOST_VERSION_MAJOR, HOST_VERSION_MINOR, HOST_VERSION_PATCH, 0
PRODUCTVERSION HOST_VERSION_MAJOR, HOST_VERSION_MINOR, HOST_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Onur BUYUKCAGLAR"
            VALUE "FileDescription", "Le Fétiche Maya 64bit"
            VALUE "FileVersion", HOST_VERSION_STR
            VALUE "InternalName", "maya64"
            VALUE "LegalCopyright", "Copyright (c) 2026 Onur BUYUKCAGLAR (MIT). The game belongs to its owners."
            VALUE "OriginalFilename", HOST_EXE
            VALUE "ProductName", "Le Fétiche Maya 64bit"
            VALUE "ProductVersion", HOST_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
